# CXO Events Mobile App — Environment Variables
#
# Copy this file to .env and fill in your values.
# Expo reads EXPO_PUBLIC_* variables at bundle time.
# Restart the Metro bundler after changing these values.

# ─── Backend API ────────────────────────────────────────────────────────────
# Base URL of the Laravel backend (no trailing slash).
# Example: https://api.cxoinc.com
EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com

# ─── Mock Mode ──────────────────────────────────────────────────────────────
# Set to "false" to use the real Laravel backend.
# Set to "true" (or leave unset) to use built-in mock data for development/demo.
#
# Demo credentials (mock mode only):
#   Phone: 5550000001 (Jessica — Attendee/Silver)
#   Phone: 5550000002 (Michael — Attendee/Gold)
#   Phone: 8156699646 (Alex    — Attendee/Bronze)
#   Phone: 5550009999 (Sarah   — Sponsor)
#   OTP:   123456     (any of the above)
EXPO_PUBLIC_USE_MOCK_API=false
