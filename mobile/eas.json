{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.cxoinc.com",
        "EXPO_PUBLIC_TENANT_ID": "3"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK_API": "false"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true,
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.cxoinc.com",
        "EXPO_PUBLIC_TENANT_ID": "3"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$EAS_APPLE_ID",
        "ascAppId": "$EAS_APPLE_ASC_APP_ID",
        "appleTeamId": "$EAS_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production"
      }
    }
  }
}
