{
  "_comment": "Schema for Laravel backend request trace. Requires Phase 4 middleware (see PERFORMANCE_FIX_PLAN.md NEXT-3). This file documents the expected log shape — populate from structured Laravel logs once middleware is deployed to staging.",
  "_middleware": "Create app/Http/Middleware/RequestDiagnosticMiddleware.php (staging only, never production)",
  "_laravelRegistration": "Register in app/Http/Kernel.php $middlewareGroups['api'] — staging environment only",
  "schema": {
    "requestId": "string — from X-Request-ID header (correlates to mobile trace)",
    "parentActionId": "string|null — from X-Parent-Action-ID header",
    "screenName": "string — from X-Screen-Name header",
    "screenInstanceId": "string — from X-Screen-Instance-ID header",
    "triggerType": "string — from X-Trigger-Type header",
    "retryNumber": "number — from X-Retry-Number header",
    "userId": "number|null — authenticated user ID (never log PII)",
    "tenantId": "string — from X-Tenant-ID header",
    "eventId": "number|null — extracted from route parameters",
    "endpoint": "string — normalized route e.g. /api/v1/events/{event}/leads/scan",
    "controller": "string — e.g. App\\Http\\Controllers\\LeadController@scan",
    "method": "string — HTTP verb",
    "requestStartAt": "string — ISO 8601 timestamp",
    "requestEndAt": "string — ISO 8601 timestamp",
    "durationMs": "number — total request duration",
    "dbQueryCount": "number — total SQL queries executed",
    "dbDurationMs": "number — total SQL time",
    "dbSlowestMs": "number — slowest individual query",
    "dbDuplicateCount": "number — queries repeated > 3 times (N+1 signal)",
    "externalHttpDurationMs": "number — time spent in outbound HTTP (email, Pusher, etc.)",
    "queueDispatchCount": "number — jobs dispatched",
    "responseStatus": "number — HTTP response code",
    "responsePayloadBytes": "number — response body size",
    "peakMemoryMb": "number — peak PHP memory during request",
    "activeRequestCount": "number — concurrent requests at time of this request",
    "flags": {
      "highQueryCount": "boolean — dbQueryCount > 25",
      "slowDb": "boolean — dbDurationMs > 500",
      "slowRequest": "boolean — durationMs > 3000",
      "possibleNPlusOne": "boolean — dbDuplicateCount > 3"
    }
  },
  "sampleEntry": {
    "requestId": "lf3kx2-a1b2c3",
    "parentActionId": "lf3kw9-x9y8z7",
    "screenName": "Engage",
    "screenInstanceId": "Engage-lf3kw1",
    "triggerType": "screen_mount",
    "retryNumber": 0,
    "userId": 1042,
    "tenantId": "3",
    "eventId": 53,
    "endpoint": "/api/v1/events/{event}/mobile-polls",
    "controller": "App\\Http\\Controllers\\PollController@index",
    "method": "GET",
    "requestStartAt": "2026-07-31T10:00:00.000Z",
    "requestEndAt": "2026-07-31T10:00:00.187Z",
    "durationMs": 187,
    "dbQueryCount": 4,
    "dbDurationMs": 22,
    "dbSlowestMs": 14,
    "dbDuplicateCount": 0,
    "externalHttpDurationMs": 0,
    "queueDispatchCount": 0,
    "responseStatus": 200,
    "responsePayloadBytes": 4821,
    "peakMemoryMb": 18.2,
    "activeRequestCount": 3,
    "flags": {
      "highQueryCount": false,
      "slowDb": false,
      "slowRequest": false,
      "possibleNPlusOne": false
    }
  }
}
