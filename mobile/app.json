{
  "expo": {
    "name": "CXO Events",
    "slug": "cxoinc",
    "owner": "quipdevs-organization",
    "version": "2.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "apexevents",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apexevents.meet",
      "infoPlist": {
        "NSCameraUsageDescription": "CXO Events uses the camera to scan attendee QR badge codes at sponsor booths.",
        "NSPhotoLibraryUsageDescription": "CXO Events may access your photo library to set a profile picture.",
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:apexevents.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070F"
      },
      "package": "com.apexevents.meet",
      "versionCode": 28,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "apexevents.com",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "CXO Events uses the camera to scan attendee QR badge codes at sponsor booths."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/83d2b604-c6aa-45fe-a707-16f09d2c578c",
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "83d2b604-c6aa-45fe-a707-16f09d2c578c"
      }
    }
  }
}
