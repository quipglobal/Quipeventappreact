{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"try{const fs=require('fs'),p=require('path'),nm=p.join(__dirname,'node_modules'),re=/^\\.[a-zA-Z].+-[A-Za-z0-9]{6,}$/;fs.readdirSync(nm).filter(f=>re.test(f)).forEach(f=>{try{fs.rmSync(p.join(nm,f),{recursive:true,force:true})}catch(e){}});fs.readdirSync(nm).filter(f=>f.startsWith('@')).forEach(s=>{try{fs.readdirSync(p.join(nm,s)).filter(f=>re.test(f)).forEach(f=>{try{fs.rmSync(p.join(nm,s,f),{recursive:true,force:true})}catch(e){}});}catch(e){}});}catch(e){}\"",
    "build": "vite build",
    "dev": "vite",
    "test:e2e": "playwright test",
    "test:dependencies": "node --test tests/unit/dependency-locks.test.mjs tests/unit/production-proxy.test.mjs && node --test mobile/scripts/test-security-deps.cjs",
    "test:proxy": "node --test tests/unit/production-proxy.test.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:load:node": "node tests/load/api-perf.js",
    "test:load-1k": "node tests/load/api-1k-concurrency.js",
    "lint": "eslint src/app/components src/app/context",
    "lint:ci": "eslint src/app/components src/app/context --max-warnings 0"
  },
