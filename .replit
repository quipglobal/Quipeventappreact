modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-no-polling-after-signout"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mobile Web Preview"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Start Mobile"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd mobile && REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start --go --port 8080"
waitForPort = 8080

[[workflows.workflow]]
name = "e2e-no-polling-after-signout"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:e2e"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Mobile Web Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd mobile && npx expo start --web --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3000

[[ports]]
localPort = 3003
externalPort = 4200

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3003

[[ports]]
localPort = 5002
externalPort = 3002

[[ports]]
localPort = 5003
externalPort = 5000

[[ports]]
localPort = 5004
externalPort = 5173

[[ports]]
localPort = 5005
externalPort = 6000

[[ports]]
localPort = 5006
externalPort = 8008

[[ports]]
localPort = 5007
externalPort = 8099

[[ports]]
localPort = 5008
externalPort = 6800

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 9000
externalPort = 9000

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "dist"
run = ["node", "server.js"]

[userenv]

[userenv.shared]
VITE_API_BASE_URL = "https://app.cxocollaborate.com"
VITE_USE_MOCK_API = "true"
EXPO_PUBLIC_API_BASE_URL = "https://app.cxocollaborate.com"
EXPO_PUBLIC_TENANT_ID = "3"
EXPO_PUBLIC_USE_MOCK_AUTH = "false"
EXPO_PUBLIC_USE_MOCK_API = "false"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[objectStorage]
defaultBucketID = "replit-objstore-ccbfeac6-5389-4851-b84a-5651fbeb06b7"
